      ["cycles","u64"],["instructions","u64"],["loads","u64"],["stores","u64"],["branches","u64"],["jumps","u64"],
      ["cpu_epoch","u32"],["stopped","u8"],["reserved0","u8"],["reserved1","u16"]
    ],
    "TRACE_DESCRIPTOR": [
      ["generation","u32"],["format","u16"],["record_bytes","u16"],["count","u16"],["depth","u16"],["flags","u32"],
      ["first_order","u64"],["last_order","u64"],["overwritten","u64"],["cpu_epoch","u32"],["reserved0","u32"]
    ],
    "TRACE_RECORD": [
      ["order_low","u32"],["pc","u32"],["instruction","u32"],["next_pc","u32"],
      ["rd_value","u32"],["memory_address","u32"],["memory_data","u32"],["flags","u32"]
    ],
    "MEM_READ_RESPONSE": [["generation","u32"],["completed","u16"],["size","u8"],["reserved0","u8"]],
    "MEM_WRITE_RESPONSE": [["completed","u16"],["size","u8"],["outcome_unknown","u8"],["address","u32"]],
    "REG_READ_RESPONSE": [["generation","u32"],["start","u8"],["count","u8"],["reserved0","u16"]],
    "REG_WRITE_RESPONSE": [["generation","u32"],["value","u32"]],
    "LOAD_PROGRESS": [["load_id","u32"],["received","u32"]],
    "OPERATION_REQUEST": [["operation_id","u64"]],
    "LOAD_RESULT": [
      ["operation_id","u64"],["kind","u8"],["state","u8"],["status","u16"],["completed","u32"],
      ["expected_crc","u32"],["observed_crc","u32"],["address","u32"],["image_id","u32"],["reserved0","u32"]
    ],
    "BIST_REQUEST": [["test_id","u8"],["reserved0","u8"],["reserved1","u16"],["address","u32"],["bytes","u32"]],
    "BIST_RESULT": [
      ["operation_id","u64"],["kind","u8"],["state","u8"],["status","u16"],["completed","u32"],
      ["first_address","u32"],["expected","u32"],["observed","u32"],["failures","u32"],
      ["address","u32"],["bytes","u32"],["phase","u8"],["reserved0","u8"],["reserved1","u16"]
    ],
    "INJECT_ARM_REQUEST": [["kind","u8"],["trigger","u8"],["duration","u16"],["address","u32"],["mask","u32"],["flags","u32"]],
    "INJECT_REQUEST": [["arm_id","u32"]],
    "INJECT_RESULT": [
      ["arm_id","u32"],["kind","u8"],["state","u8"],["flags","u16"],["address","u32"],["mask","u32"],
      ["saved_value","u32"],["trigger_value","u32"],["observed_value","u32"],["trigger_count","u32"],
      ["operation_id","u64"],["detection_status","u16"],["cleanup_status","u16"],["restored_value","u32"]
    ],
    "HELLO_RESPONSE": [
      ["protocol_version", "u8"], ["schema_minor", "u8"], ["descriptor_bytes", "u16"],
      ["build_id", "u32"], ["isa_flags", "u32"], ["clock_hz", "u32"],
      ["max_payload", "u16"], ["max_chunk", "u16"], ["capabilities", "u32"],
      ["breakpoint_count", "u8"], ["trace_format", "u8"], ["trace_depth", "u16"],
      ["cpu_state", "u8"], ["operation_state", "u8"], ["session_state", "u8"], ["reserved0", "u8"],
      ["lease_remaining_ms", "u16"], ["operation_states_supported", "u16"]
    ],
    "STATUS_RESPONSE": [
      ["cpu_state", "u8"], ["halt_reason", "u8"], ["operation_state", "u8"], ["valid", "u8"],
      ["last_retired_pc", "u32"], ["next_pc", "u32"], ["image_id", "u32"],
      ["operation_id", "u64"], ["frames_rejected", "u32"], ["uart_overruns", "u32"],
      ["snapshot_generation", "u32"]
    ]
  }
}
