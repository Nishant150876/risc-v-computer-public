    "DISCONNECTED": 0, "DISCOVERING": 1, "CONNECTED": 2, "RECONCILING": 3,
    "READY": 4, "DEGRADED": 5
  },
  "session_states": {"NONE": 0, "YOURS": 1, "OTHER": 2},
  "halt_reasons": {"NONE": 0, "REQUEST": 1, "STEP": 2, "BREAKPOINT": 3, "FAULT": 4, "RESET": 5},
  "isa_flags": {"RV32I": 0},
  "status_valid_bits": {"LAST_PC": 0, "NEXT_PC": 1, "IMAGE": 2, "MODIFIED": 3},
  "payloads": {
    "REG_READ_REQUEST": [["start","u8"],["count","u8"],["reserved0","u16"]],
    "REG_WRITE_REQUEST": [["index","u8"],["reserved0","u8"],["reserved1","u16"],["value","u32"]],
    "MEM_REQUEST": [["address","u32"],["size","u8"],["flags","u8"],["count","u16"]],
    "LOAD_BEGIN_FIXED": [
