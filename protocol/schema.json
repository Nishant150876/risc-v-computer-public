    "BREAK_SET_REQUEST": [["slot","u8"],["enabled","u8"],["reserved0","u16"],["pc","u32"]],
    "BREAK_CLEAR_REQUEST": [["slot","u8"],["reserved0","u8"],["reserved1","u16"]],
