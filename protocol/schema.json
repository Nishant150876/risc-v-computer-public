{
  "protocol_version": 1,
  "schema_minor": 0,
  "limits": {
    "header_bytes": 24,
    "max_payload": 256,
    "crc_bytes": 4,
    "max_frame": 284,
    "max_encoded": 286,
    "max_wire": 287,
    "interbyte_timeout_ms": 100,
    "lease_ms": 2000,
    "response_timeout_ms": 500,
    "max_retries": 3,
    "keepalive_ms": 500,
    "max_mem_data": 192,
    "max_chunk": 192,
    "max_name": 48,
    "max_ping_echo": 32
  },
  "channels": {"CONTROL": 0, "CONSOLE": 1, "EVENT": 2},
  "kinds": {"REQUEST": 0, "RESPONSE": 1, "EVENT": 2},
  "opcodes": {
    "HELLO": 1, "PING": 2, "STATUS": 3,
