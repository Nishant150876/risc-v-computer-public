    "UNSUPPORTED": 256, "BAD_ARGUMENT": 257, "BAD_ADDRESS": 258, "ALIGNMENT": 259,
    "BAD_STATE": 260, "BUSY": 261, "BAD_SESSION": 262, "ID_CONFLICT": 263,
    "STALE_REQUEST": 264, "BUS_ERROR": 265, "OUTCOME_UNKNOWN": 266, "IMAGE_INVALID": 267,
    "VERIFY_FAILED": 268, "ABORTED": 269, "NOT_FOUND": 270
  },
  "frame_errors": {
    "OK": 0, "TOO_LONG": 1, "COBS_INVALID": 2, "TOO_SHORT": 3, "BAD_LENGTH": 4,
    "BAD_CRC": 5, "BAD_VERSION": 6, "BAD_RESERVED": 7, "BAD_CHANNEL": 8, "BAD_KIND": 9,
    "TIMEOUT": 10
  },
  "capabilities": {
    "BASE_STATUS": 0, "RAM_ACCESS": 1, "LOADER": 2, "CONSOLE": 3,
    "HALT_RESUME": 4, "REG_ACCESS": 5, "STEP": 6, "BREAKPOINTS": 7,
    "PIPE_SNAPSHOT": 8, "RETIRE_TRACE": 9, "BASE_COUNTERS": 10, "PERF64": 11,
