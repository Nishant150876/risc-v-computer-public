# T1 UI defaults for the M5Stack Tab5 (ESP32-P4, 16 MB flash, 32 MB PSRAM).
# Board settings match t0_probe; build success does not pass its UART/electrical gates.
CONFIG_IDF_TARGET="esp32p4"

# Tab5 ships with an ESP32-P4 older than chip revision 3.0.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Codec/camera options copied from the BSP's own example config
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_CAM_CTRL_SPI_ENABLE=n

# FreeRTOS: needed for the stack high-water marks on the System screen
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# LVGL 9. Fonts must match ui/ui_internal.h and sim/lv_conf.h.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_ASSERT_HANDLER_INCLUDE="assert.h"
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_UNSCII_16=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y

# UI rotation: landscape 1280 x 720 (see main/Kconfig.projbuild)
CONFIG_T1_UI_ROTATION_90=y
